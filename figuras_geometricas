
using System;

class Program
{
    static void Main(string[] args)
    {
        int opcion;
        int tamano;

        do
        {
            Console.Clear();
            Console.WriteLine("===== MENU PRINCIPAL =====");
            Console.WriteLine("1. Cuadrado hueco");
            Console.WriteLine("2. Triangulo invertido");
            Console.WriteLine("3. Piramide centrada");
            Console.WriteLine("4. Salir");
            Console.WriteLine("==========================");
            Console.Write("Selecciona una opcion: ");

            if (!int.TryParse(Console.ReadLine(), out opcion))
            {
                Console.WriteLine("Error: debes ingresar un numero.");
                Console.WriteLine("Presiona una tecla para continuar...");
                Console.ReadKey();
                opcion = 0;
                continue;
            }

            switch (opcion)
            {
                case 1:
                    Console.Clear();
                    Console.WriteLine("===== CUADRADO HUECO =====");
                    Console.Write("Ingresa el tamano del cuadrado: ");

                    if (!int.TryParse(Console.ReadLine(), out tamano) ||
                        tamano < 1)
                    {
                        Console.WriteLine(
                            "Error: ingresa un numero entero mayor que 0.");
                    }
                    else
                    {
                        for (int i = 0; i < tamano; i++)
                        {
                            for (int j = 0; j < tamano; j++)
                            {
                                if (i == 0 || i == tamano - 1 ||
                                    j == 0 || j == tamano - 1)
                                {
                                    Console.Write("*");
                                }
                                else
                                {
                                    Console.Write(" ");
                                }
                            }

                            Console.WriteLine();
                        }
                    }

                    Console.WriteLine();
                    Console.WriteLine("Presiona una tecla para continuar...");
                    Console.ReadKey();
                    break;

                case 2:
                    Console.Clear();
                    Console.WriteLine("===== TRIANGULO INVERTIDO =====");

                    for (int i = 0; i < 5; i++)
                    {
                        for (int j = 0; j < 5 - i; j++)
                        {
                            Console.Write("*");
                        }

                        Console.WriteLine();
                    }

                    Console.WriteLine();
                    Console.WriteLine("Presiona una tecla para continuar...");
                    Console.ReadKey();
                    break;

                case 3:
                    Console.Clear();
                    Console.WriteLine("===== PIRAMIDE CENTRADA =====");

                    for (int i = 0; i < 5; i++)
                    {
                        for (int j = 0; j < 4 - i; j++)
                        {
                            Console.Write(" ");
                        }

                        for (int k = 0; k < 2 * i + 1; k++)
                        {
                            Console.Write("*");
                        }

                        Console.WriteLine();
                    }

                    Console.WriteLine();
                    Console.WriteLine("Presiona una tecla para continuar...");
                    Console.ReadKey();
                    break;

                case 4:
                    Console.WriteLine("Saliendo del programa...");
                    break;

                default:
                    Console.WriteLine("Opcion no valida. Intenta de nuevo.");
                    Console.ReadKey();
                    break;
            }

        } while (opcion != 4);
    }
}
